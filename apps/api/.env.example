# Template for apps/api/.env — copy to .env and fill in real values.
# This file is safe to commit (no real secrets). The real .env stays git-ignored.

# ==============================================================================
# PLATFORM / APP
# Capabilities: Database, auth/session runtime, app routing, local storage paths
# ==============================================================================
DATABASE_URL=file:./dev.db
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=brokerino_session
AUTH_COOKIE_SECURE=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_BASE_URL=http://localhost:4173
TTS_AUDIO_DIR=./data/audio

# ==============================================================================
# CLAUDE
# Capabilities: LLM analysis, curation, report/chat reasoning
# ==============================================================================
ANTHROPIC_API_KEY=

# ==============================================================================
# GOOGLE
# Capabilities: OAuth login, Google TTS, Google endpoint overrides
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_CREDENTIALS=
TTS_GOOGLE_TTS_URL=https://texttospeech.googleapis.com/v1/text:synthesize
TTS_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token

# ==============================================================================
# OPENAI
# Capabilities: Studio TTS audio rendering via OpenAI API
# ==============================================================================
OPENAI_API_KEY=
TTS_OPENAI_BASE_URL=

# ==============================================================================
# YOUTUBE
# Capabilities: Source crawl/transcript access, YouTube search endpoints
# ==============================================================================
YOUTUBE_COOKIE=
YOUTUBE_API_KEY=
SOURCE_SEARCH_YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3/search
SOURCE_SEARCH_YOUTUBE_WEB_URL=https://www.youtube.com/results

# ==============================================================================
# ITUNES
# Capabilities: Podcast source search endpoint configuration
# ==============================================================================
SOURCE_SEARCH_ITUNES_URL=https://itunes.apple.com/search

# ==============================================================================
# RESEND / SMTP
# Capabilities: Outbound email delivery for notifications/auth flows
# ==============================================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM="Maydoz <no-reply@mail.yourdomain.com>"

# ==============================================================================
# RESIDENTIAL PROXY
# Capabilities: Route blocked outbound calls through residential proxy
# ==============================================================================
YOUTUBE_PROXY_URL=
TTS_PROXY_URL=
