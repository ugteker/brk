# Misc
*.tmp
*.temp
.cache/

# Impeccable critique reports (scratch review output)
.impeccable/

# Brainstorm session runtime state (pid/instance-id/stopped flags) for any session ID
/.superpowers/brainstorm/*/state/

# Local-only sdd session artifacts (kept on disk, not tracked in git)
/.superpowers/sdd/realtime-task-3-report.md

# Google service-account keys (never commit)
apps/api/keys/
secrets/
/.superpowers/catalog-preview/

# Cloudflare Origin Certificate/key (never commit — belongs in GitHub secrets only)
apps/web/certs/
*.pem
*.key
